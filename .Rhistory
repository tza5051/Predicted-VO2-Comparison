(SpiderPlot_maleBMI + SpiderPlot_femaleBMI) / (SpiderPlot_maleAge + SpiderPlot_femaleAge) + plot_layout(guides = "collect") + plot_annotation(tag_levels = c('A', '1')) & theme(legend.position = "bottom")
