# Differences in gender:
SpiderPlot_Gender %>%
mutate(gender =
case_when(
gender == 1 ~ "Male",
gender == 2 ~ "Female"
)) %>%
ggplot(aes(x = gender, y = Mean_Predicted, group = Equation, color = Equation)) +
geom_line(size = 1) +
geom_point() +
labs(title = "Mean Percent Predicted Per Gender", y = "Percent Predicted", x = "") +
theme(
axis.title = element_text(size = 16),
legend.text = element_text(size = 14),
legend.title = element_text(size = 14),
axis.text = element_text(size = 14)
) +
scale_fill_jco() +
scale_color_jco()
# Initialize a list to store results
results <- list()
# Loop through each equation
for(Equation in unique(SpiderPlot_Gender$Equation)) {
# Filter data for the current equation
data <- SpiderPlot_Gender %>% filter(Equation == Equation)
# Split data by gender
male_values <- data %>% filter(gender == 1) %>% pull(Mean_Predicted)
female_values <- data %>% filter(gender == 2) %>% pull(Mean_Predicted)
# Perform Wilcoxon rank-sum test (Mann-Whitney U test)
test_result <- wilcox.test(male_values, female_values, alternative = "two.sided")
# Store the results
results[[Equation]] <- c(U_statistic = test_result$statistic, p_value = test_result$p.value)
}
# Convert results to a data frame for easy viewing
results_df <- do.call(rbind, results) %>%
as.data.frame() %>%
rownames_to_column(var = "Equation")
# Print the results
print(results_df)
View(results)
View(SpiderPlot_Gender)
View(results)
View(results_df)
View(results_wilcox)
female_values
