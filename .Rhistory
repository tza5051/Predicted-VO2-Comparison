AccessCPET <- AccessCPET %>%
mutate(
Race_Combined = case_when(
Race_Combined == "White" ~ "Caucasian",
Race_Combined == "African-American" ~ "Black",
Race_Combined == "Black or African-American" ~ "Black",
TRUE ~Race_Combined))
AccessCPET <- AccessCPET %>%
group_by(Race_Combined) %>%
summarise(n=n())
